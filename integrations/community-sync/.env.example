# community-sync configuration -- copy to `.env` and fill in real values.
#
# The real `.env` is git-ignored (see the repository .gitignore). NEVER commit
# secrets. These values are read from the process environment; the tool does not
# parse this file itself. Load it however you prefer, e.g.:
#
#     set -a; source .env; set +a
#     python community_sync.py sync --roster roster.json
#
# ---------------------------------------------------------------------------

# Attio API key. Generate one in the Attio web app:
#   Workspace settings -> Developers -> API keys -> Create key
# The key must be allowed to read/write People records and Lists.
ATTIO_API_KEY=

# Slack bot token (starts with "xoxb-"). Create a Slack app, add the scopes
# below, install it to the workspace, and invite the bot to the target channel.
#
# Required bot token scopes:
#   channels:read       list/resolve PUBLIC channels
#   groups:read         list/resolve PRIVATE channels (if the community is private)
#   users:read          read user profiles (names)
#   users:read.email    read the `email` field (required; users:read alone is NOT enough)
SLACK_BOT_TOKEN=
